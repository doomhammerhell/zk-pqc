{
  "name": "zk-pqc-infrastructure",
  "version": "1.0.0",
  "description": "Post-Quantum Signature Verification for STARK-Based Smart Contracts",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^17.0.4",
    "prettier": "^2.8.0",
    "semantic-release": "^21.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yml}": "prettier --write",
    "*.rs": [
      "bash -c 'cargo fmt --all --manifest-path src/rust/Cargo.toml -- --check'",
      "bash -c 'cargo clippy --all-targets --all-features --manifest-path src/rust/Cargo.toml -- -D warnings'"
    ],
    "*.cairo": "bash -c 'cd src/cairo && scarb fmt --check'"
  }
}

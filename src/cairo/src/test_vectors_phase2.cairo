//! Test Vector Consumer for Phase 2 Components in Cairo.
//!
//! Validates HexTree, XMSS, WOTS+ Hybrid, and domain separation vectors
//! generated by Rust against Cairo implementations.

use zk_pqc_cairo::domain::canonical_message_hash;
use zk_pqc_cairo::hextree::{HexProof, verify_hextree_proof};
use zk_pqc_cairo::poseidon::PoseidonHash;
use zk_pqc_cairo::wots::{WotsParams, WotsSignature, verify_wots};
use zk_pqc_cairo::xmss::verify_xmss;

/// Test vector entry for HexTree.
#[derive(Drop, Serde)]
struct HexTreeVector {
    id: felt252,
    leaves: Array<felt252>,
    expected_root: felt252,
    proofs: Array<HexProofVector>,
}

/// Proof vector for HexTree.
#[derive(Drop, Serde)]
struct HexProofVector {
    leaf_index: u32,
    leaf_value: felt252,
    siblings: Array<Array<felt252>>,
    path_indices: Array<u8>,
}

/// Test vector entry for XMSS.
#[derive(Drop, Serde)]
struct XmssVector {
    id: felt252,
    tree_height: u32,
    seed: Array<felt252>,
    message: felt252,
    signature_index: u64,
    expected_root: felt252,
    signature: XmssSignatureVector,
}

/// XMSS signature vector.
#[derive(Drop, Serde)]
struct XmssSignatureVector {
    index: u64,
    wots_sig: WotsSignatureVector,
    wots_pubkey_commitment: felt252,
    proof_siblings: Array<Array<felt252>>,
    proof_path_indices: Array<u8>,
}

/// WOTS+ signature vector.
#[derive(Drop, Serde)]
struct WotsSignatureVector {
    chain_values: Array<felt252>,
}

/// Test vector entry for domain separation.
#[derive(Drop, Serde)]
struct DomainSeparationVector {
    id: felt252,
    domain: felt252,
    chain_id: felt252,
    contract_addr: felt252,
    nonce: u64,
    calldata_hash: felt252,
    expected_canonical_hash: felt252,
}

/// Validates HexTree test vectors.
/// Returns true if all vectors pass validation.
fn validate_hextree_vectors(vectors: Span<HexTreeVector>) -> bool {
    let mut i: u32 = 0;
    while i < vectors.len() {
        let v = vectors.at(i);

        // Validate each proof
        let mut j: u32 = 0;
        while j < v.proofs.len() {
            let proof_vec = v.proofs.at(j);

            // Build HexProof from vector
            let mut siblings: Array<[felt252; 15]> = ArrayTrait::new();
            let mut k: u32 = 0;
            while k < proof_vec.siblings.len() {
                let sib_level = proof_vec.siblings.at(k);
                // Convert Array<felt252> to [felt252; 15]
                let mut sib_arr: [felt252; 15] = [0; 15];
                let mut s: u32 = 0;
                while s < 15 && s < sib_level.len() {
                    sib_arr[s] = *sib_level.at(s);
                    s += 1;
                }
                siblings.append(sib_arr);
                k += 1;
            }

            let proof = HexProof { siblings, path_indices: proof_vec.path_indices.clone() };

            // Verify proof
            let is_valid = verify_hextree_proof::<
                PoseidonHash,
            >(*v.expected_root, proof_vec.leaf_index.into(), proof_vec.leaf_value, proof);

            if !is_valid {
                return false;
            }

            j += 1;
        }

        i += 1;
    }

    true
}

/// Validates XMSS test vectors.
/// Returns true if all vectors pass validation.
fn validate_xmss_vectors(vectors: Span<XmssVector>) -> bool {
    let mut i: u32 = 0;
    while i < vectors.len() {
        let v = vectors.at(i);

        // Build XMSS signature
        let wots_sig = WotsSignature { chain_values: v.signature.wots_sig.chain_values.clone() };

        // Build XmssSignature
        let sig = zk_pqc_cairo::xmss::XmssSignature {
            index: v.signature.index,
            wots_sig,
            wots_pubkey_commitment: v.signature.wots_pubkey_commitment,
            proof_siblings: v.signature.proof_siblings.clone(),
            proof_path_indices: v.signature.proof_path_indices.clone(),
        };

        // Verify XMSS signature
        let params = WotsParams { w: 16 };
        let is_valid = verify_xmss::<
            PoseidonHash,
        >(*v.expected_root, *v.signature_index, *v.message, @sig, @params);

        if !is_valid {
            return false;
        }

        i += 1;
    }

    true
}

/// Validates domain separation test vectors.
/// Returns true if all vectors pass validation.
fn validate_domain_vectors(vectors: Span<DomainSeparationVector>) -> bool {
    let mut i: u32 = 0;
    while i < vectors.len() {
        let v = vectors.at(i);

        // Compute canonical hash
        let computed_hash = canonical_message_hash::<
            PoseidonHash,
        >(*v.domain, *v.chain_id, *v.contract_addr, *v.nonce, *v.calldata_hash);

        // Verify matches expected
        if computed_hash != *v.expected_canonical_hash {
            return false;
        }

        i += 1;
    }

    true
}

/// Validates all Phase 2 test vectors.
/// This is the main entry point for Cairo test vector validation.
///
/// # Returns
/// * `true` if all vectors pass
/// * `false` if any vector fails
pub fn validate_all_phase2_vectors(
    hextree_vectors: Span<HexTreeVector>,
    xmss_vectors: Span<XmssVector>,
    domain_vectors: Span<DomainSeparationVector>,
) -> bool {
    // Validate HexTree vectors
    if !validate_hextree_vectors(hextree_vectors) {
        return false;
    }

    // Validate XMSS vectors
    if !validate_xmss_vectors(xmss_vectors) {
        return false;
    }

    // Validate Domain Separation vectors
    if !validate_domain_vectors(domain_vectors) {
        return false;
    }

    true
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_validate_domain_vectors() {
        // Create test domain vectors
        let domain = 0x7A6B2D7661756C74; // "zk-pqc-vault"
        let chain_id = 0x534E5F4D41494E; // "SN_MAIN"
        let contract_addr = 0x1234567890abcdef;
        let calldata_hash = 0x3039; // 12345

        let computed = canonical_message_hash::<
            PoseidonHash,
        >(domain, chain_id, contract_addr, 0, calldata_hash);

        let vector = DomainSeparationVector {
            id: 'test',
            domain,
            chain_id,
            contract_addr,
            nonce: 0,
            calldata_hash,
            expected_canonical_hash: computed,
        };

        let mut vectors: Array<DomainSeparationVector> = ArrayTrait::new();
        vectors.append(vector);

        assert!(validate_domain_vectors(vectors.span()), "Domain vector validation failed");
    }
}

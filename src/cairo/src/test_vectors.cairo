    // ═══════════════════════════════════════════════════════════════
    // Hybrid Hash Vectors (from spec/test_vectors/hybrid_hash.json)
    // SHA-256 truncation now matches between Rust and Cairo:
    // both zero the MSB of the full 32-byte SHA-256 output.
    // ═══════════════════════════════════════════════════════════════

    #[test]
    fn test_vec_hybrid_001() {
        // input: [1, 2], ds=0
        let input = array![1, 2];
        let result = HashFunction::<HybridHashWrapper>::hash(input.span());
        let expected: felt252 = 0x01670e1b083e4272c8d1a59d97e936e9f6be42872b509243a97438083840e69f;
        assert(result == expected, 'hybrid_001 mismatch');
    }

    #[test]
    fn test_vec_hybrid_002() {
        // input: [10, 20, 30], ds=0
        let input = array![10, 20, 30];
        let result = HashFunction::<HybridHashWrapper>::hash(input.span());
        let expected: felt252 = 0x0609eeb8ddb1f035aa976eed0525f46fd6a3f0d3ba520a02ab8a0e06b20b182b;
        assert(result == expected, 'hybrid_002 mismatch');
    }

    #[test]
    fn test_vec_hybrid_003() {
        // input: [42], ds=5
        let input = array![42];
        let result = HashFunction::<HybridHashWrapper>::hash_with_domain_separation(5, input.span());
        let expected: felt252 = 0x024040444b5ef483e9fdce7e64882519670c0683565e47f3745eca8cd154b773;

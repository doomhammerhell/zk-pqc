//! Cross-language test vector consumer.
//!
//! Verifies that Cairo cryptographic outputs match Rust-generated expected values.
//! Test vectors are generated by `zk_pqc_test_vectors` (Rust) and embedded here as constants.
//! See `spec/test_vectors/` for the JSON source files.

#[cfg(test)]
mod test_vectors {
    use zk_pqc_cairo::hash_trait::{HashFunction, PoseidonHash, HybridHashWrapper};
    use zk_pqc_cairo::sponge::{hash as sponge_hash, hash_with_ds as sponge_hash_with_ds};
    use zk_pqc_cairo::merkle::{build_tree, root, prove, verify};
    use zk_pqc_cairo::lamport::{
        keygen as lamport_keygen, sign as lamport_sign, verify as lamport_verify, felt_to_bits,
    };
    use zk_pqc_cairo::wots::{
        keygen as wots_keygen, sign as wots_sign, verify as wots_verify,
    };

    // ═══════════════════════════════════════════════════════════════
    // Poseidon Hash Vectors (from spec/test_vectors/poseidon_hash.json)
    // ═══════════════════════════════════════════════════════════════

    #[test]
    fn test_vec_poseidon_001() {
        // input: [1, 2, 3], ds=0
        let input = array![1, 2, 3];
        let result = HashFunction::<PoseidonHash>::hash(input.span());
        let expected: felt252 = 0x0229c3badfe4df4f36a1f39ad2c11977054f6da237ffb485ce6ce05ef30a417b;
        assert(result == expected, 'poseidon_001 mismatch');
    }

    #[test]
    fn test_vec_poseidon_002() {
        // input: [42], ds=0
        let input = array![42];
        let result = HashFunction::<PoseidonHash>::hash(input.span());
        let expected: felt252 = 0x063042d6b82fb9e46160c157b684d00088dc1614467fb66f451161c6ef9a818b;
        assert(result == expected, 'poseidon_002 mismatch');
    }

    #[test]
    fn test_vec_poseidon_003() {
        // input: [1, 2], ds=1
        let input = array![1, 2];
        let result = HashFunction::<PoseidonHash>::hash_with_domain_separation(1, input.span());
        let expected: felt252 = 0x004f82ff97cbcc369e93b085f58acaf76d642bf31270d6df254a291db48982c2;
        assert(result == expected, 'poseidon_003 mismatch');
    }

    #[test]
    fn test_vec_poseidon_004() {
        // input: [10, 20, 30, 40, 50], ds=0
        let input = array![10, 20, 30, 40, 50];
        let result = HashFunction::<PoseidonHash>::hash(input.span());
        let expected: felt252 = 0x01765492573fb6fbcaf59974f06aa19917e3e1bd52f0339d5a5caf91b79ec924;
        assert(result == expected, 'poseidon_004 mismatch');
    }

